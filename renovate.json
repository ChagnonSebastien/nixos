{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "nix": {
    "enabled": true
  },
  "ignoreDeps": [
    "secrets",
    "services"
  ],
  "automerge": false,
  "packageRules": [
    {
      "description": "channel upgrades wait for approval in the Dependency Dashboard",
      "matchManagers": [
        "nix"
      ],
      "dependencyDashboardApproval": true
    }
  ]
}
